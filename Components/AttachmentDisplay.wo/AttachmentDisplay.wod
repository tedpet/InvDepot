IsPdf : WOConditional {
  condition = isPdf;
}

PdfLink : ERAttachmentLink {
  attachment = attachment;
}

IsWord : WOConditional {
  condition = isWord;
}

WordPreview : WOString {
  value = wordPreviewHtml;
  escapeHTML = false;
}

WordLink : ERAttachmentLink {
  attachment = attachment;
}

PdfImage : WOGenericElement {
  elementName = "img";
  src = pdfPreviewSrc;
  width = 200;
  style = "border: 1px solid #ccc;";
}

IsSpreadsheet : WOConditional {
  condition = isSpreadsheet;
}

SheetTable : WOString {
  value = spreadsheetPreviewHtml;
  escapeHTML = false;
}

SheetLink : ERAttachmentLink {
  attachment = attachment;
}

IsOther : WOConditional {
  condition = isOther;
}

Viewer : ERAttachmentViewer {
  attachment = attachment;
  width = 200;
}